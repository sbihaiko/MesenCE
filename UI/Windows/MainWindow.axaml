<Window xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:m="clr-namespace:Mesen"
	xmlns:c="using:Mesen.Controls"
	xmlns:v="using:Mesen.Views"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="505"
	x:Class="Mesen.Windows.MainWindow"
	Width="512" Height="505"
	MinWidth="160" MinHeight="144"
	DragDrop.AllowDrop="True"
	x:DataType="vm:MainWindowViewModel"
	Topmost="{Binding Config.Preferences.AlwaysOnTop}"
	Title="{Binding WindowTitle}"
>

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vm:AudioPlayerViewModel}">
			<v:AudioPlayerView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:RecentGamesViewModel}">
			<DockPanel>
				<!--P.7 (PRD Part B §6.2): Welcome card - shown once, on the very
				first Player-mode boot (recents necessarily empty); its one CTA
				("Load ROM") is also what dismisses it for good.-->
				<Border Name="PlayerWelcomeCard" DockPanel.Dock="Top" Background="#22FFFFFF" Padding="16" Margin="0 0 0 8" IsVisible="{Binding ShowWelcomeCard}">
					<StackPanel Spacing="8" HorizontalAlignment="Center">
						<TextBlock Text="{l:Translate lblWelcomeCardTitle}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
						<TextBlock Text="{l:Translate lblWelcomeCardBody}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Center" />
						<Button Content="{l:Translate btnWelcomeCardLoadRom}" HorizontalAlignment="Center" Click="OnWelcomeCardLoadRom" />
					</StackPanel>
				</Border>
				<!--P.7 (§6.2): Continue card - not first-run gated, simply shown
				whenever there is a most-recent game to resume; sits alongside the
				recent-games grid, same as any other home entry.-->
				<Border Name="PlayerContinueCard" DockPanel.Dock="Top" Background="#22FFFFFF" Padding="12" Margin="0 0 0 8" IsVisible="{Binding ShowContinueCard}">
					<Button HorizontalAlignment="Stretch" Click="OnContinueCard" Content="{Binding ContinueLabel}" />
				</Border>
				<c:StateGrid IsVisible="{Binding Visible}" Entries="{Binding GameEntries}" Title="{Binding Title}" Mode="{Binding Mode}" />
			</DockPanel>
		</DataTemplate>
	</Window.DataTemplates>
	
	<DockPanel>
		<Panel DockPanel.Dock="Top" IsVisible="{Binding IsMenuVisible}">
			<Panel DataContext="{Binding MainMenu}">
				<v:MainMenuView Name="MainMenu" />
			</Panel>
		</Panel>
		
		<ContentControl Name="AudioPlayer" DockPanel.Dock="Bottom" Content="{Binding AudioPlayer}" />

		<Panel Name="RendererPanel" Background="Black" Focusable="True">
			<ContentControl Background="#181818" Content="{Binding RecentGames}" IsVisible="{Binding RecentGames.Visible}" />

			<ContentControl
				Name="RendererContainer"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
			/>

			<Panel IsVisible="{Binding IsSoftwareRendererVisible}">
				<c:SoftwareRendererView
					Name="SoftwareRenderer"
					DataContext="{Binding SoftwareRenderer}"
					Width="{Binding Width}"
					Height="{Binding Height}"
			  />
			</Panel>

			<!--P.4 (PRD Part B §6): the thin Player-mode overlay. Painted on
			top of the game; D-pad/A/B navigation comes from Avalonia focus
			(normal buttons, no pointer required). "Save/Load slot" is two buttons
			here (Save slot / Load slot) for clarity; the Pack item opens the pack
			window for now - the pack picker that replaces it is P.5.-->
			<Border
				Name="PlayerOverlay"
				Background="#CC000000"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Padding="24"
				IsVisible="{Binding IsPlayerOverlayVisible}"
			>
				<StackPanel Spacing="10" MinWidth="220">
					<Button Name="OverlayResumeButton" Content="{l:Translate btnOverlayResume}" HorizontalAlignment="Stretch" Click="OnOverlayResume" />
					<Button Content="{l:Translate btnOverlaySaveSlot}" HorizontalAlignment="Stretch" Click="OnOverlaySave" />
					<Button Content="{l:Translate btnOverlayLoadSlot}" HorizontalAlignment="Stretch" Click="OnOverlayLoad" />
					<!--P.5 (§5): the current pack chip - shows the applied pack and
					opens the picker (2+ choices) or the pack window (single).-->
					<Button HorizontalAlignment="Stretch" Click="OnOverlayPack">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="{l:Translate btnOverlayPack}" />
							<TextBlock Text="{Binding CurrentPackName}" FontWeight="Bold" />
						</StackPanel>
					</Button>
					<!--P.7 (§6.1): the quick-toggle panel for Texture/Audio/WideScrn/
					HiRes/Overclock.-->
					<Button Content="{l:Translate btnOverlayEnhancements}" HorizontalAlignment="Stretch" Click="OnOverlayEnhancements" />
					<Button Content="{l:Translate btnOverlaySettings}" HorizontalAlignment="Stretch" Click="OnOverlaySettings" />
					<Button Content="{l:Translate btnOverlayAdvancedGui}" HorizontalAlignment="Stretch" Click="OnOverlayAdvanced" />
					<Button Content="{l:Translate btnOverlayQuit}" HorizontalAlignment="Stretch" Click="OnOverlayQuit" />
				</StackPanel>
			</Border>

			<!--P.7 (PRD Part B §6.1): the Enhancements quick-toggle panel - a
			checkbox grid over config that already exists elsewhere
			(EnhancementPackConfig.EnableTextures/EnableAudio, VideoConfig.
			AspectRatio/VideoFilter, the per-console overclock field). On/off is
			derived from that config, not a second stored flag; Click (not
			IsCheckedChanged) drives the toggle so the checkbox's visual state
			always reflects what the ViewModel just confirmed was applied.
			Overclock is disabled (not hidden, so the grid layout never shifts
			per console) where the loaded console has no overclock knob (SMS).-->
			<Border
				Name="PlayerEnhancementsPanel"
				Background="#DD000000"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Padding="24"
				IsVisible="{Binding IsEnhancementsPanelVisible}"
			>
				<StackPanel Spacing="10" MinWidth="260">
					<TextBlock Text="{l:Translate lblEnhancementsPanelTitle}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
					<CheckBox Name="EnhancementsTexturesCheckBox" Content="{l:Translate chkEnhancementsTextures}" IsChecked="{Binding IsTexturesEnabled, Mode=OneWay}" Click="OnToggleTextures" />
					<CheckBox Content="{l:Translate chkEnhancementsAudio}" IsChecked="{Binding IsAudioEnabled, Mode=OneWay}" Click="OnToggleAudio" />
					<CheckBox Content="{l:Translate chkEnhancementsBorder}" IsChecked="{Binding IsBorderEnabled, Mode=OneWay}" Click="OnToggleBorder" />
					<CheckBox Content="{l:Translate chkEnhancementsWideScrn}" IsChecked="{Binding IsWideScrnEnabled, Mode=OneWay}" Click="OnToggleWideScrn" />
					<CheckBox Content="{l:Translate chkEnhancementsHiRes}" IsChecked="{Binding IsHiResEnabled, Mode=OneWay}" Click="OnToggleHiRes" />
					<CheckBox Content="{l:Translate chkEnhancementsOverclock}" IsChecked="{Binding IsOverclockEnabled, Mode=OneWay}" IsEnabled="{Binding IsOverclockSupported}" Click="OnToggleOverclock" />
					<Button Content="{l:Translate btnEnhancementsClose}" HorizontalAlignment="Stretch" Click="OnCloseEnhancementsPanel" />
				</StackPanel>
			</Border>

			<!--P.5 (PRD Part B §5): the pack picker - opens once over the
			un-enhanced game when 2+ competing pack_ids exist and no stored choice
			applies. Picking stores the per-ROM preference (P.3) and power-cycles;
			dismissing plays un-enhanced and asks again next launch. D-pad/A/B via
			Avalonia focus (first choice auto-focused on open).-->
			<Border
				Name="PlayerPackPicker"
				Background="#DD000000"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Padding="24"
				IsVisible="{Binding IsPlayerPackPickerVisible}"
			>
				<StackPanel Spacing="10" MinWidth="340" MaxWidth="520">
					<TextBlock Text="{l:Translate lblChoosePackForThisGame}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
					<ItemsControl Name="PackPickerList" ItemsSource="{Binding PlayerPackChoices}" XYFocus.NavigationModes="Enabled">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="8" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button HorizontalAlignment="Stretch" Tag="{Binding Container}" Click="OnPickPlayerPack">
									<StackPanel Spacing="2">
										<TextBlock FontWeight="Bold" Text="{Binding Name}" />
										<TextBlock FontSize="11" Opacity="0.7" Text="{Binding Detail}" />
										<!-- ADR-0152: a reviewed known-missing declaration is shown on the
										     row it belongs to, naming MesenCE validation as its source so the
										     gap is never read as the author's claim. Collapsed when absent. -->
										<TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
											IsVisible="{Binding HasKnownMissing}" Text="{Binding KnownMissingNote}" />
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Content="{l:Translate btnPlayWithoutPack}" HorizontalAlignment="Stretch" Click="OnDismissPlayerPackPicker" />
				</StackPanel>
			</Border>
		</Panel>
	</DockPanel>
</Window>
