<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Fase 0 test harness (docs/roadmap/plano-testes-unitarios.md).
		Deliberately host-free: no RuntimeIdentifier, no ProjectReference to UI/UI.csproj,
		no Avalonia/EmuApi packages. This project must be able to `dotnet test` on any OS
		without SDL2/MesenCore/Avalonia being present. See UI.Tests/AGENTS.md.
	-->
	<PropertyGroup>
		<!-- Parity with UI.csproj: UI/Logic files dual-compiled here must be AOT/trim-safe too
		     (reflection-based System.Text.Json would pass tests and fail in the published app). -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<IsAotCompatible>true</IsAotCompatible>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<!-- Parity with UI/UI.csproj (which does not set ImplicitUsings): the
		     host-free dual-compile must match the app's compile conditions, so
		     test-side code cannot lean on implicit usings. Warnings are errors
		     here for the same reason (ADR-0123 H5). -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>Mesen.Tests</RootNamespace>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- This project's own tests (obj/bin excluded: EnableDefaultCompileItems=false means
		     this manual glob would otherwise pick up generated files under obj/ too). -->
		<Compile Include="**/*.cs" Exclude="bin/**/*.cs;obj/**/*.cs" />
		<!-- Host-free logic under UI/Logic/, compiled a second time here (no ProjectReference
		     to UI.csproj) so any accidental Avalonia/EmuApi dependency breaks `dotnet test`
		     instead of only being caught by review. -->
		<Compile Include="../UI/Logic/**/*.cs" />
		<!-- ConsoleType/CheatType (Fase 2): host-free enums split out of the Avalonia-tainted
		     UI/Interop/EmuApi.cs into UI/Interop/InteropEnums.cs. Included by exact file, not
		     a folder glob, since the rest of UI/Interop/ still references Avalonia/EmuApi. -->
		<Compile Include="../UI/Interop/InteropEnums.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
